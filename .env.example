# Local-only values for docker compose. Replace before use; never reuse in a deployed environment.
POSTGRES_PASSWORD=facet_local_only
JWT_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=Facet.Local
NUXT_PUBLIC_API_BASE=http://localhost:5000/api
# Optional: create the first administrator on initial database startup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
