{
	"info": {
		"_postman_id": "de4407ed-9209-4259-bd42-454828868e22",
		"name": "facet",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "48243079"
	},
	"item": [
		
		{
			"name": "Upload File",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Upload succeeded and returned document info\", function () {",
							"    const data = pm.response.json();",
							"    // ASP.NET Core serializes properties to camelCase by default, so check 'success'",
							"    pm.expect(data).to.have.property('success', true);",
							"    pm.expect(data.document).to.be.an('object');",
							"    pm.expect(data.document.sizeBytes).to.be.a('number').that.is.above(0);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": "{{uploadFilePath}}"
						}
					]
				},
				"url": {
					"raw": "{{url}}/api/documents/upload",
					"host": [
						"{{url}}"
					],
					"path": [
						"api",
						"documents",
						"upload"
					]
				}
			},
			"response": []
		}
	]
}