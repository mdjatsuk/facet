<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
  <TargetFramework>net9.0-windows</TargetFramework>
  <!-- This project uses System.Drawing for rasterization on Windows; target the Windows flavor of net9.0. -->
  <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  <PackageReference Include="System.Drawing.Common" Version="7.0.0" Condition=" '$(OS)' == 'Windows_NT' " />
  <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
  <PackageReference Include="Xceed.Words.NET" Version="3.0.1" />
  </ItemGroup>
</Project>
